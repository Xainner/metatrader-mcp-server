# MetaTrader 5 MCP Server Credentials Example
LOGIN=your_login_here
PASSWORD=your_password_here
SERVER=your_server_here

# Optional: Path to MT5 terminal executable (auto-detected if not specified)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# MCP Transport Configuration (defaults: local STDIO; HTTP transports bind to 127.0.0.1)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# Required for any non-loopback MCP_HOST (at least 32 random characters):
# MCP_AUTH_TOKEN=
# TLS for non-loopback hosts (or MCP_ALLOW_INSECURE_REMOTE=true behind a TLS proxy):
# MCP_SSL_CERTFILE=
# MCP_SSL_KEYFILE=
# MCP_ALLOWED_HOSTS=mt5.example.com:8080

# REST API (metatrader-http-server)
# OPENAPI_AUTH_TOKEN=
# OPENAPI_CORS_ORIGINS=http://localhost:3000

# Trading safety controls (empty = disabled)
# MT5_ALLOW_LIVE_TRADING=false
# MT5_MAX_VOLUME_PER_ORDER=0.1
# MT5_MAX_TOTAL_VOLUME=1.0
# MT5_MAX_OPEN_POSITIONS=5
# MT5_MAX_RISK_PER_TRADE_PCT=1
# MT5_REQUIRE_STOP_LOSS=true
# MT5_MAX_DAILY_LOSS=200
# MT5_DUPLICATE_WINDOW_SECONDS=10
# MT5_ALLOW_NEW_ENTRIES=true
# MT5_BLOCK_ON_UNRESOLVED=true
# MT5_MAX_ENTRIES_PER_DAY=10
# MT5_MAX_AGGREGATE_RISK_PCT=3
# MT5_STRATEGY_LIMITS={"breakout": {"max_total_volume": 0.5, "max_open_positions": 2}}
# MT5_STRATEGY_MAGICS={"breakout": 7001}
# MT5_MISSING_PROTECTION_POLICY=report   # report | retry_sltp | close

# Durable state: request registry, limits log, supervisor rules (no credentials)
# MT5_STATE_DB=C:\Users\you\.metatrader_mcp\state.sqlite3
# MT5_REQUEST_STALE_SECONDS=120
# MT5_REQUEST_RETENTION_DAYS=90

# Pre-trade previews
# MT5_PREVIEW_TTL_SECONDS=30
# MT5_PREVIEW_MAX_PRICE_MOVE_POINTS=20
# MT5_REQUIRE_PREVIEW=false

# Time and data
# MT5_SERVER_UTC_OFFSET_SECONDS=10800   # trade server clock minus UTC (e.g. UTC+3)
# MT5_MAX_CANDLES=5000

# Position supervisor (rules only run after create_position_rule)
# MT5_SUPERVISOR_ENABLED=true
# MT5_SUPERVISOR_INTERVAL_SECONDS=5
# MT5_SUPERVISOR_MAX_STALE_SECONDS=120

# MCP bridge and logs (stdout is JSON-RPC; logs go to a rotating file)
# MCP_READ_TIMEOUT_SECONDS=30
# MCP_SEND_TIMEOUT_SECONDS=60
# MCP_AUTO_RECONNECT=true
# MCP_RECONNECT_MAX_ATTEMPTS=3
# MCP_RECONNECT_WINDOW_SECONDS=300
# MCP_LOG_FILE=C:\Users\you\.metatrader_mcp\logs\metatrader_mcp.log
# MCP_LOG_LEVEL=INFO
# MCP_LOG_MAX_BYTES=5000000
# MCP_LOG_BACKUPS=3
# MCP_LOG_STDERR_LEVEL=off

# Integration tests: only against a dedicated demo account
# MT5_RUN_INTEGRATION=1

# WebSocket Quote Server Configuration
# QUOTE_HOST=127.0.0.1
# QUOTE_PORT=8765
# QUOTE_SYMBOLS=XAUUSD,USOIL,GBPUSD,USDJPY,EURUSD,BTCUSD
# QUOTE_POLL_INTERVAL_MS=100
